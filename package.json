    "db:sync:remote": "node scripts/sync-anime.mjs"
  },
  "dependencies": {
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.3.0",
    "motion": "^12.38.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.31",
    "plyr": "^3.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-paginate": "^8.3.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.110.0"
