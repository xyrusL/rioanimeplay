{
  "name": "rioanime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:nodemon": "nodemon",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rioanime-db --local",
